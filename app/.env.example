# Copy to .env and fill in. This directory is a standalone client; it has no
# dependency on the `rag` package and can be run from anywhere.

# Base URL of the rag-study API service. Run it with `just serve` in the
# rag-study repository, or point this at a deployed instance.
RAG_API_URL=http://localhost:8080

# Shared secret for the service's X-API-Key header. Must match the RAG_API_KEY
# the service was started with. This is a secret: keep the real value in .env,
# never in .env.example. Leave empty only when talking to a service that was
# itself started without a key (which then serves nothing but /health).
RAG_API_KEY=

# Passages to request per question. The service clamps this to its own maximum.
RAG_CHAT_TOP_K=5

# Force demo mode: stream a canned answer through the UI without calling the
# service at all. Demo mode is also entered automatically when the service
# cannot be reached. Anything in 1/true/yes/on turns it on.
RAG_CHAT_DEMO=
