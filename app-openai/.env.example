# Copy to .env and fill in. This directory is a standalone client; it has no
# dependency on the `rag` package and can be run from anywhere.

# Root URL of the OpenAI-language RAG provider. With or without a trailing
# /v1 — the client adds the version segment only when it is missing. The target
# is a local OpenAI-compatible server (vLLM, llama.cpp, LM Studio, Ollama's
# /v1) or a local RAG service speaking that dialect.
RAG_OPENAI_BASE_URL=https://api.openai.com

# Bearer token for the provider. This is a secret: keep the real value in .env,
# never in .env.example. Leave empty only for a provider that needs no
# credential (a local server, say).
RAG_OPENAI_API_KEY=

# Model id to name in the request body. Leave empty to adopt the first model
# the provider lists at GET /v1/models.
RAG_OPENAI_MODEL=

# Optional endpoint the rating buttons POST to. Empty means ratings are
# acknowledged in the UI but not stored anywhere.
RAG_OPENAI_FEEDBACK_URL=

# Force demo mode: decode a canned OpenAI-shaped chunk stream through the real
# client without touching the network. Demo mode is also entered automatically
# when the provider cannot be reached. Anything in 1/true/yes/on turns it on.
RAG_OPENAI_DEMO=
