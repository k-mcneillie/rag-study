# Copy to .env and fill in. NEVER commit the resulting .env file.
# Every value here is a placeholder; none are real credentials.

# --- Database -----------------------------------------------------------
# Use a dedicated least-privilege account. The application user needs only
# SELECT, INSERT, UPDATE and DELETE on the runtime schema; it should not be
# root and should not hold DDL or administrative privileges.
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=3306
RAG_DB_USER=rag_app
RAG_DB_PASSWORD=replace-with-a-generated-password
RAG_DB_NAME=rag_study

# Disposable schema used by the integration test suite, which creates and
# drops its own tables.
RAG_TEST_DB_NAME=rag_study_test

# --- Local model assets -------------------------------------------------
# Model weights are provisioned separately from Python dependencies and are
# never downloaded at runtime. The path may be relative to the project root.
# Loading fails with a clear error if the directory is missing.
RAG_EMBEDDING_MODEL_PATH=models/embeddings/all-MiniLM-L6-v2
RAG_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Must match the VECTOR column width in the database schema.
RAG_EMBEDDING_DIMENSION=384

# --- Chunking -----------------------------------------------------------
# Target chunk size and overlap, in characters.
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150

# --- Reranking (optional) -----------------------------------------------
# Local cross-encoder used to reorder candidates. Leave unset to keep the
# initial vector ranking. An unset path means the stage is not used; no
# default location is searched and nothing is ever downloaded.
RAG_RERANKER_MODEL_PATH=models/rerankers/ms-marco-MiniLM-L-6-v2
RAG_RERANKER_BATCH_SIZE=16

# --- Prompting ----------------------------------------------------------
# Which versioned template renders retrieved context. Changing the prompt is
# a configuration change, so a past result can be reproduced by restoring the
# configuration that produced it. Templates live in src/rag/retrieval/prompts.
RAG_PROMPT_NAME=retrieval_context
RAG_PROMPT_VERSION=v1

# --- Limits -------------------------------------------------------------
# Upper bound on results a single retrieval request may ask for.
RAG_MAX_TOP_K=100
# Chunks encoded per batch, bounding peak memory during embedding.
RAG_EMBEDDING_BATCH_SIZE=32
# Refuse documents larger than this, or with more pages than this.
RAG_MAX_DOCUMENT_BYTES=104857600
RAG_MAX_DOCUMENT_PAGES=2000
